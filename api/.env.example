# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Connection string dari Supabase → Project Settings → Database → Connection string.
# Pakai mode "Session pooler" untuk DATABASE_URL (Prisma migrate butuh koneksi langsung).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public"

# ─── Supabase (Auth + Storage) ───────────────────────────────────────────────
SUPABASE_URL="https://<ref>.supabase.co"
# Service role key — HANYA dipakai di server, jangan pernah dikirim ke klien.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ─── Aplikasi ────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
# Origin PWA yang diizinkan (pisahkan dengan koma bila lebih dari satu).
CORS_ORIGINS="http://localhost:5173"

# ─── Storage ─────────────────────────────────────────────────────────────────
# Nama bucket Supabase Storage untuk foto struk.
SUPABASE_RECEIPTS_BUCKET="receipts"
