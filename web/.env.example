# URL backend NestJS. Saat `npm run dev`, Vite mem-proxy /api ke localhost:3000,
# jadi cukup "/api". Untuk build produksi, isi URL absolut API-nya.
VITE_API_BASE_URL="/api"

# Kredensial Supabase Auth — aman dipakai di klien (anon key memang publik).
# Jangan pernah menaruh service role key di sini.
VITE_SUPABASE_URL="https://<ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key>"
